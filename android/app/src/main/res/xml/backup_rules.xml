<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup rules -->
<!-- Exclude everything: the wallet is recovered via Google Drive App Data folder (per-user),
     never via Android Auto Backup (which would mix wallets across Google accounts). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
    </device-transfer>
</data-extraction-rules>
